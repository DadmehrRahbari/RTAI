---
// Lead visual for the homepage: a four-zone MLOps pipeline, Build, Ship,
// Run, Govern, generic for any kind of AI system. The Run zone shows the
// trust layer's actual integration point ("reads outputs only, of any
// perception or decision model") with a scoped live animation on just that
// pair, plus the one hard number worth anchoring: the parameter-count ratio
// between the trust layer and what it audits.
---

<div class="max-w-3xl mx-auto">
  <div class="flex items-stretch gap-1.5">

    <div class="flex-1 min-w-0 border border-ink-600 p-3 sm:p-4">
      <p class="font-display text-base font-semibold text-paper-100 mb-2.5">Build</p>
      <div class="flex items-center gap-2">
        <div class="w-7 h-7 rounded-full bg-ink-800 border border-ink-600 flex items-center justify-center shrink-0">
          <i class="ti ti-database text-xs text-paper-300" aria-hidden="true"></i>
        </div>
        <p class="text-xs font-medium text-paper-300 m-0">Data</p>
      </div>
      <p class="text-[11px] text-paper-500 mt-1 leading-snug">Collect, label, version, any input modality.</p>
      <div class="h-px bg-ink-600 my-2.5"></div>
      <div class="flex items-center gap-2">
        <div class="w-7 h-7 rounded-full bg-ink-800 border border-dashed border-ink-600 flex items-center justify-center shrink-0">
          <i class="ti ti-checkbox text-xs text-paper-300" aria-hidden="true"></i>
        </div>
        <p class="text-xs font-medium text-paper-300 m-0">Validate</p>
      </div>
      <p class="text-[11px] text-paper-500 mt-1 leading-snug">Three-arm fault benchmark: no healing vs. a checksum baseline vs. this.</p>
    </div>

    <div class="flex items-center shrink-0">
      <i class="ti ti-chevron-right text-sm text-paper-500" aria-hidden="true"></i>
    </div>

    <div class="flex-1 min-w-0 border border-ink-600 p-3 sm:p-4">
      <p class="font-display text-base font-semibold text-paper-100 mb-2.5">Ship</p>
      <div class="flex items-center gap-2">
        <div class="w-7 h-7 rounded-full bg-ink-800 border border-ink-600 flex items-center justify-center shrink-0">
          <i class="ti ti-rocket text-xs text-paper-300" aria-hidden="true"></i>
        </div>
        <p class="text-xs font-medium text-paper-300 m-0">Deploy</p>
      </div>
      <p class="text-[11px] text-paper-500 mt-1 leading-snug">Staged, canary rollout across the fleet.</p>
      <div class="h-px bg-ink-600 my-2.5"></div>
      <div class="flex items-center gap-2">
        <div class="w-7 h-7 rounded-full bg-ink-800 border border-ink-600 flex items-center justify-center shrink-0">
          <i class="ti ti-fingerprint text-xs text-paper-300" aria-hidden="true"></i>
        </div>
        <p class="text-xs font-medium text-paper-300 m-0">Fingerprint</p>
      </div>
      <p class="text-[11px] text-paper-500 mt-1 leading-snug">A trust anchor is issued for this release.</p>
    </div>

    <div class="flex items-center shrink-0">
      <i class="ti ti-chevron-right text-sm text-paper-500" aria-hidden="true"></i>
    </div>

    <div class="relative flex-1 min-w-0 border border-amber-600/60 bg-amber-500/[0.06] p-3 sm:p-4">
      <span class="absolute -top-2.5 right-2 bg-amber-500 text-ink-950 text-[11px] font-semibold px-2 py-0.5 rounded-full">
        154x lighter
      </span>
      <p class="font-display text-base font-semibold text-amber-400 mb-2.5">Run</p>

      <div id="pulse-a" class="border border-amber-600/60 px-2 py-1.5 flex items-center gap-1.5">
        <i class="ti ti-shield-check text-xs text-amber-400" aria-hidden="true"></i>
        <span class="text-xs font-medium text-amber-400">Trust layer</span>
      </div>
      <div class="text-center leading-none my-1">
        <i id="pulse-arrow" class="ti ti-arrows-vertical text-sm text-paper-500" aria-hidden="true"></i>
      </div>
      <div id="pulse-b" class="pulse-target border border-ink-600 px-2 py-1.5 flex items-center gap-1.5">
        <i class="ti ti-cpu text-xs text-paper-300" aria-hidden="true"></i>
        <span class="text-xs text-paper-300">Any Big-AI</span>
      </div>
      <p class="text-[11px] text-paper-500 mt-1.5 leading-snug">Reads outputs only. Gates the action before it happens.</p>

      <div class="h-px bg-ink-600 my-2.5"></div>
      <div class="flex items-center gap-2">
        <div class="w-7 h-7 rounded-full bg-ink-800 border border-amber-600/60 flex items-center justify-center shrink-0">
          <i class="ti ti-refresh text-xs text-amber-400" aria-hidden="true"></i>
        </div>
        <p class="text-xs font-medium text-paper-300 m-0">Heal</p>
      </div>
      <p class="text-[11px] text-paper-500 mt-1 leading-snug">Fine-tune, validate, roll back, in-process.</p>
    </div>

    <div class="flex items-center shrink-0">
      <i class="ti ti-chevron-right text-sm text-paper-500" aria-hidden="true"></i>
    </div>

    <div class="flex-1 min-w-0 border border-ink-600 p-3 sm:p-4">
      <p class="font-display text-base font-semibold text-paper-100 mb-2.5">Govern</p>
      <div class="flex items-center gap-2">
        <div class="w-7 h-7 rounded-full bg-ink-800 border border-teal-600/60 flex items-center justify-center shrink-0">
          <i class="ti ti-affiliate text-xs text-teal-400" aria-hidden="true"></i>
        </div>
        <p class="text-xs font-medium text-paper-300 m-0">Fleet</p>
      </div>
      <p class="text-[11px] text-paper-500 mt-1 leading-snug">Federated aggregation issues the next trust anchor.</p>
      <div class="h-px bg-ink-600 my-2.5"></div>
      <div class="flex items-center gap-2">
        <div class="w-7 h-7 rounded-full bg-ink-800 border border-ink-600 flex items-center justify-center shrink-0">
          <i class="ti ti-eye text-xs text-paper-300" aria-hidden="true"></i>
        </div>
        <p class="text-xs font-medium text-paper-300 m-0">Observe</p>
      </div>
      <p class="text-[11px] text-paper-500 mt-1 leading-snug">Dashboard, alerts, escalation to a human.</p>
    </div>

  </div>

  <p class="text-center text-[11px] text-paper-500 mt-4">
    <i class="ti ti-corner-up-left text-xs -mb-px mr-1" aria-hidden="true"></i>
    every fix and every fleet learning feeds back into data and the next CI gate
  </p>
</div>

<script>
  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) return;

    var b = document.getElementById('pulse-b');
    var arrow = document.getElementById('pulse-arrow');
    if (!b || !arrow) return;

    var phase = 0;
    function apply(state) {
      b.classList.remove('is-fault', 'is-healing', 'is-healthy');
      if (state === 'fault') {
        b.classList.add('is-fault');
        arrow.className = 'ti ti-alert-triangle text-sm text-fault-400';
      } else if (state === 'healing') {
        b.classList.add('is-healing');
        arrow.className = 'ti ti-refresh text-sm text-amber-400';
      } else {
        b.classList.add('is-healthy');
        arrow.className = 'ti ti-arrows-vertical text-sm text-teal-400';
      }
    }

    setInterval(function () {
      phase = (phase + 1) % 3;
      apply(phase === 0 ? 'healthy' : phase === 1 ? 'fault' : 'healing');
    }, 1600);
  })();
</script>
