---
import BaseLayout from '../layouts/BaseLayout.astro';
import IntegrationHub from '../components/IntegrationHub.astro';
import { site } from '../site.config';

const pillars = [
  {
    n: '01',
    title: 'Detect',
    body: 'Every inference is checked against multiple independent signals, embedding-space novelty, sensor health, temporal consistency, spatial plausibility, so no single trick fools the system.',
  },
  {
    n: '02',
    title: 'Diagnose',
    body: 'A fault-localization layer decides where the problem actually is: the AI model, the monitor watching it, or a physical sensor, before anything is repaired.',
  },
  {
    n: '03',
    title: 'Heal',
    body: 'Hardware faults trigger a verified resync from a trusted source. Genuine drift triggers an in-process fine-tune, validated against held-out data before it is ever trusted.',
  },
  {
    n: '04',
    title: 'Learn',
    body: 'What one unit learns strengthens the fleet through reliability-weighted aggregation, low-trust updates are down-weighted automatically, not blindly averaged in.',
  },
];

const stats = [
  { value: '154x', label: 'fewer parameters than the model it audits' },
  { value: '< 1', label: 'frame to detect a hardware-level fault' },
  { value: '0', label: 'raw weights or gradients required from your model' },
  { value: '4', label: 'independent failure modes covered, not one confidence score' },
];

const principles = [
  { title: 'Independent', body: "Doesn't share failure modes with what it watches." },
  { title: 'Verifiable', body: 'Checks its own integrity against an external anchor, not itself.' },
  { title: 'Fast enough to act', body: 'Gates the action in real time, not a dashboard after the fact.' },
  { title: 'Bounded and reversible', body: 'Every automated fix is validated, and can always be rolled back.' },
];
---

<BaseLayout title={site.name}>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-ink-600">
    <div class="mx-auto max-w-6xl px-6 pt-20 pb-16 sm:pt-28 sm:pb-24">
      <p class="eyebrow">Independent trust layer for any AI-based system</p>
      <h1 class="mt-5 max-w-3xl font-display text-4xl sm:text-6xl font-semibold leading-[1.05] tracking-tight">
        Your AI model will fail. <span class="text-amber-400">Make sure something notices.</span>
      </h1>
      <p class="mt-6 max-w-2xl text-base sm:text-lg text-paper-300">
        {site.name} is a lightweight, independent monitor that watches any AI-based system's decision-making,
        perception, control, classification, or otherwise, inference by inference, catches silent failures a
        confidence score would miss, and recovers automatically, without ever needing access to the model
        it's watching.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href={`${import.meta.env.BASE_URL}/contact`} class="btn-primary">Talk to us</a>
        <a href={`${import.meta.env.BASE_URL}/integrate`} class="btn-secondary">Integrate the SDK</a>
      </div>

      <div class="mt-14">
        <IntegrationHub />
      </div>
    </div>
  </section>

  <!-- Problem -->
  <section class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
    <div class="grid gap-10 md:grid-cols-[0.9fr_1.1fr] md:gap-16">
      <div>
        <p class="eyebrow">The problem</p>
        <h2 class="mt-4 font-display text-2xl sm:text-3xl font-semibold leading-tight">
          AI models fail silently. Confidence scores don't help.
        </h2>
      </div>
      <div class="space-y-6 text-paper-300">
        <p>
          A network can be simultaneously wrong and highly confident, a documented failure mode across
          nearly every deep learning deployment, in perception, forecasting, control, or classification
          alike. If a model's own softmax output is the only signal available, whatever fools its decision
          head also fools any check built purely from that same head.
        </p>
        <p>
          A monitor built entirely from a model's outputs can also fail on its own: bit-flips, memory
          corruption, and compute-path faults affect the watcher just as much as the watched. A system
          that never checks its own integrity has no way to tell "the world genuinely changed" from
          "my own reasoning is broken."
        </p>
        <p class="text-paper-100">
          {site.name} is built around both halves of that problem: independent, multi-signal detection,
          and a monitor that audits its own trustworthiness before it ever audits yours.
        </p>
      </div>
    </div>
  </section>

  <!-- Pillars -->
  <section class="border-y border-ink-600 bg-ink-900/40">
    <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
      <p class="eyebrow">How it works</p>
      <h2 class="mt-4 max-w-xl font-display text-2xl sm:text-3xl font-semibold leading-tight">
        A tiered pipeline that runs on every inference, not a post-hoc dashboard.
      </h2>

      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          pillars.map((p) => (
            <div class="panel">
              <span class="font-mono text-xs text-amber-500">{p.n}</span>
              <h3 class="mt-3 font-display text-lg font-semibold">{p.title}</h3>
              <p class="mt-3 text-sm text-paper-300">{p.body}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-10 flex flex-wrap gap-x-8 gap-y-2">
        <a href={`${import.meta.env.BASE_URL}/product`} class="text-sm font-mono uppercase tracking-wider text-teal-400 hover:text-teal-300">
          Read the full architecture &rarr;
        </a>
        <a href={`${import.meta.env.BASE_URL}/integrate`} class="text-sm font-mono uppercase tracking-wider text-teal-400 hover:text-teal-300">
          See the SDK &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- MLOps Pipeline -->
  <section class="border-y border-ink-600 bg-ink-900/40">
    <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
      <p class="eyebrow">MLOps pipeline</p>
      <h2 class="mt-4 max-w-xl font-display text-2xl sm:text-3xl font-semibold leading-tight">
        Continuous validation for deployed AI models, in production, not just at training time.
      </h2>
      <div class="mt-14 grid gap-6 sm:grid-cols-3">
        <div class="panel">
          <h3 class="font-display text-lg font-semibold">Real-time telemetry</h3>
          <p class="mt-3 text-sm text-paper-300">Continuous stream processing of edge inferences and confidence distributions.</p>
        </div>
        <div class="panel">
          <h3 class="font-display text-lg font-semibold">Automated triggers</h3>
          <p class="mt-3 text-sm text-paper-300">Instant fallback routing when confidence scores or sensor cross-checks degrade.</p>
        </div>
        <div class="panel">
          <h3 class="font-display text-lg font-semibold">Safe rollback</h3>
          <p class="mt-3 text-sm text-paper-300">Atomic version switches to known-good model weights without human intervention.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Principles teaser -->
  <section class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
    <p class="eyebrow">What trustworthy edge AI requires</p>
    <h2 class="mt-4 max-w-xl font-display text-2xl sm:text-3xl font-semibold leading-tight">
      A framework we use to evaluate ourselves, not just a pitch.
    </h2>
    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        principles.map((p) => (
          <div class="border-t border-ink-600 pt-5">
            <h3 class="font-display text-base font-semibold text-paper-100">{p.title}</h3>
            <p class="mt-2 text-sm text-paper-500">{p.body}</p>
          </div>
        ))
      }
    </div>
    <div class="mt-10">
      <a href={`${import.meta.env.BASE_URL}/technology`} class="text-sm font-mono uppercase tracking-wider text-teal-400 hover:text-teal-300">
        Read all seven principles &rarr;
      </a>
    </div>
  </section>

  <!-- Stats -->
  <section class="mx-auto max-w-6xl px-6 py-20 sm:py-28 border-t border-ink-600">
    <p class="eyebrow">Why it fits on the edge</p>
    <h2 class="mt-4 max-w-xl font-display text-2xl sm:text-3xl font-semibold leading-tight">
      Small enough to run everywhere your model does.
    </h2>
    <div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        stats.map((s) => (
          <div class="border-t border-ink-600 pt-5">
            <div class="font-display text-3xl sm:text-4xl font-semibold text-paper-100">{s.value}</div>
            <div class="mt-2 text-sm text-paper-500">{s.label}</div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Industries strip -->
  <section class="border-t border-ink-600 bg-ink-900/40">
    <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
      <p class="eyebrow">Built for any AI-based system that can't afford to guess</p>
      <h2 class="mt-4 max-w-xl font-display text-2xl sm:text-3xl font-semibold leading-tight">
        Where a silent AI failure is not an acceptable outcome.
      </h2>
      <p class="mt-4 max-w-2xl text-sm text-paper-500">
        The three below are where we've validated the deepest. The architecture itself is domain-agnostic --
        see the full list on the Industries page.
      </p>
      <div class="mt-10 grid gap-6 sm:grid-cols-3">
        <a href={`${import.meta.env.BASE_URL}/industries`} class="panel block hover:border-amber-500/50 transition-colors">
          <h3 class="font-display text-lg font-semibold">Drones & robotics</h3>
          <p class="mt-3 text-sm text-paper-300">Fleet-wide perception integrity, with a real safety gate on the controller.</p>
        </a>
        <a href={`${import.meta.env.BASE_URL}/industries`} class="panel block hover:border-amber-500/50 transition-colors">
          <h3 class="font-display text-lg font-semibold">Defense & ISR</h3>
          <p class="mt-3 text-sm text-paper-300">Black-box by design, your model's weights never leave your control.</p>
        </a>
        <a href={`${import.meta.env.BASE_URL}/industries`} class="panel block hover:border-amber-500/50 transition-colors">
          <h3 class="font-display text-lg font-semibold">Industrial automation</h3>
          <p class="mt-3 text-sm text-paper-300">Local self-healing keeps a line moving without a round trip to the cloud.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-6xl px-6 py-24 sm:py-32 text-center">
    <h2 class="font-display text-3xl sm:text-4xl font-semibold max-w-2xl mx-auto leading-tight">
      Let's find out what your system doesn't know it's missing.
    </h2>
    <p class="mt-5 text-paper-300 max-w-xl mx-auto">
      Bring your model. We'll show you what an independent monitor catches in the first hour.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a href={`${import.meta.env.BASE_URL}/contact`} class="btn-primary">Talk to us</a>
      <a href={`${import.meta.env.BASE_URL}/integrate`} class="btn-secondary">Read the integration guide</a>
    </div>
  </section>
</BaseLayout>
