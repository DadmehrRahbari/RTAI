---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
---

<BaseLayout title="Contact" description="Get in touch.">
  <section class="mx-auto max-w-6xl px-6 pt-20 pb-16 sm:pt-28 sm:pb-20 border-b border-ink-600">
    <p class="eyebrow">Contact</p>
    <h1 class="mt-5 max-w-2xl font-display text-4xl sm:text-5xl font-semibold leading-tight">
      Tell us about the system you're building.
    </h1>
    <p class="mt-6 max-w-xl text-lg text-paper-300">
      One perception model, one deployment target, a few sentences on what "failure" looks like for you --
      that's enough for a first conversation.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
    <div class="grid gap-16 md:grid-cols-[1fr_1.2fr]">
      <div>
        <p class="eyebrow">Direct</p>
        <a href={`mailto:${site.email}`} class="mt-4 block font-display text-2xl font-semibold hover:text-amber-400">
          {site.email}
        </a>
        <p class="mt-6 text-sm text-paper-500">{site.location}</p>

        <div class="mt-10 flex gap-4 font-mono text-xs uppercase tracking-wider">
          <a href={site.social.linkedin} class="text-paper-300 hover:text-amber-400">LinkedIn</a>
          <a href={site.social.github} class="text-paper-300 hover:text-amber-400">GitHub</a>
        </div>
      </div>

      <div class="panel">
        <div data-fs-success class="hidden rounded border border-teal-500/30 bg-teal-500/10 p-4 font-mono text-xs text-teal-400">
          Thanks! Your message has been sent successfully. We'll be in touch soon.
        </div>
        <div data-fs-error class="hidden rounded border border-red-500/30 bg-red-500/10 p-4 font-mono text-xs text-red-400"></div>

        <form id="contact-form" class="space-y-5 mt-4">
          <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />

          <div>
            <label for="name" class="font-mono text-xs uppercase tracking-wider text-paper-500">Name</label>
            <input id="name" name="name" type="text" required data-fs-field
              class="mt-2 w-full border border-ink-600 bg-ink-900 px-4 py-3 text-sm text-paper-100 focus:border-amber-500 outline-none" />
          </div>

          <div>
            <label for="email" class="font-mono text-xs uppercase tracking-wider text-paper-500">Email</label>
            <input id="email" name="email" type="email" required data-fs-field
              class="mt-2 w-full border border-ink-600 bg-ink-900 px-4 py-3 text-sm text-paper-100 focus:border-amber-500 outline-none" />
          </div>

          <div>
            <label for="company" class="font-mono text-xs uppercase tracking-wider text-paper-500">Company</label>
            <input id="company" name="company" type="text" data-fs-field
              class="mt-2 w-full border border-ink-600 bg-ink-900 px-4 py-3 text-sm text-paper-100 focus:border-amber-500 outline-none" />
          </div>

          <div>
            <label for="message" class="font-mono text-xs uppercase tracking-wider text-paper-500">What are you building?</label>
            <textarea id="message" name="message" rows="5" required data-fs-field
              class="mt-2 w-full border border-ink-600 bg-ink-900 px-4 py-3 text-sm text-paper-100 focus:border-amber-500 outline-none"></textarea>
          </div>

          <button type="submit" data-fs-submit-btn class="btn-primary">Send</button>
        </form>
      </div>
    </div>
  </section>

  <script>
    window.formspree = window.formspree || function () { (formspree.q = formspree.q || []).push(arguments); };
    formspree('initForm', { formElement: '#contact-form', formId: 'xdeokwzj' });
  </script>
  <script src="https://unpkg.com/@formspree/ajax@1" defer></script>
</BaseLayout>